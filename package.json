{
  "name": "cybership-carrier-integration",
  "version": "1.0.0",
  "description": "Carrier integration service wrapping UPS Rating API with extensible architecture, OAuth token management, and integration tests.",
  "type": "module",
  "main": "dist/index.js",
  "author": "",
  "license": "ISC",

  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist"
  },

  "keywords": [
    "typescript",
    "shipping",
    "ups",
    "carrier-integration",
    "oauth",
    "backend"
  ],

  "dependencies": {
    "axios": "^1.13.5",
    "dotenv": "^17.2.4",
    "zod": "^4.3.6"
  },

  "devDependencies": {
    "@types/node": "^25.2.2",
    "nock": "^14.0.10",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },

  "engines": {
    "node": ">=18"
  }
}
